# Modular KYC backend (no trailing slash)
# Local:  http://localhost:8010/api/v1/modular
# Prod:   https://kyc-verif-new.fly.dev/api/v1/modular
KYC_API_BASE_URL=https://kyc-verif-new.fly.dev/api/v1/modular

# App ObjectId from Modular KYC Apps collection (required)
# Must match the same environment as KYC_API_BASE_URL (prod app id ≠ local app id)
KYC_APP_ID=

# Where the KYC web UI lives (used for redirect after complete)
KYC_FRONTEND_URL=https://kyc-verif-new.fly.dev

# Optional default webhook for generated sessions
KYC_DEFAULT_CALLBACK_URL=https://webhook.site/#!/view/your-unique-id
